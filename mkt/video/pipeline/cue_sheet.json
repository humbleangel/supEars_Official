 "texts": [
  {
   "id": "hook",
   "chapter": "HOOK",
   "text": "Are you tired of paying subscriptions to talk?",
   "lang": "en",
   "start": 0.0,
   "end": 3.2,
   "style": "hero",
   "y": 470,
   "snap": 0.0
  },
  {
   "id": "pain1",
   "chapter": "HOOK",
   "text": "You pay every month.",
   "lang": "en",
   "start": 3.3,
   "end": 7.1,
   "style": "hero",
   "y": 470,
   "snap": 3.4285714285714284
  },
  {
   "id": "pain2",
   "chapter": "HOOK",
   "text": "to type one sentence.",
   "lang": "en",
   "start": 5.0,
   "end": 7.1,
   "style": "sub",
   "y": 600,
   "snap": 5.142857142857142
  },
  {
   "id": "quote1",
   "chapter": "HOOK",
   "text": "\u201cWindows speech recognition accuracy was too low.\u201d",
   "lang": "en",
   "start": 7.3,
   "end": 8.5,
   "style": "quote",
   "y": 1010,
   "snap": 7.285714285714286
  },
  {
   "id": "brand",
   "chapter": "MECH",
   "text": "The Ear that understands your language.",
   "lang": "en",
   "start": 8.8,
   "end": 12.3,
   "style": "claim",
   "y": 870,
   "snap": 9.0
  },
  {
   "id": "quote2",
   "chapter": "MECH",
   "text": "\u201cLocal offline speech recognition. No internet needed.\u201d",
   "lang": "en",
   "start": 9.95,
   "end": 11.95,
   "style": "quote",
   "y": 1010,
   "snap": 9.857142857142856
  },
  {
   "id": "mech1",
   "chapter": "MECH",
   "text": "Click.",
   "lang": "en",
   "start": 12.8,
   "end": 14.3,
   "style": "hero3",
   "y": 750,
   "snap": 12.857142857142856
  },
  {
   "id": "mech2",
   "chapter": "MECH",
   "text": "Speak.",
   "lang": "en",
   "start": 14.3,
   "end": 15.8,
   "style": "hero3",
   "y": 750,
   "snap": 14.142857142857142
  },
  {
   "id": "mech3",
