   "text": "Magic.",
   "lang": "en",
   "start": 15.8,
   "end": 17.3,
   "style": "hero3",
   "y": 750,
   "snap": 15.857142857142856
  },
  {
   "id": "cry",
   "chapter": "MECH",
   "text": "Escape the Subscriptions Trap.",
   "lang": "en",
   "start": 18.0,
   "end": 20.4,
   "style": "cry",
   "y": 540,
   "snap": 18.0
  },
  {
   "id": "draft1",
   "chapter": "MECH",
   "text": "Fale no seu idioma.",
   "lang": "pt",
   "start": 15.2,
   "end": 17.1,
   "style": "draft",
   "y": 0,
   "snap": 15.0
  },
  {
   "id": "draft2",
   "chapter": "MECH",
   "text": "Speak in your own native language.",
   "lang": "en",
   "start": 15.9,
   "end": 17.3,
   "style": "draft",
   "y": 0,
   "snap": 15.857142857142856
  },
  {
   "id": "es",
   "chapter": "WALL",
   "text": "Habla en espa\u00f1ol.",
   "lang": "es",
   "start": 20.75,
   "end": 25.55,
   "style": "hero",
   "y": 350,
   "snap": 20.57142857142857
  },
  {
   "id": "es_sub",
   "chapter": "WALL",
   "text": "supEars escribe en ingl\u00e9s.",
   "lang": "en",
   "start": 22.15,
   "end": 25.55,
   "style": "sub",
   "y": 620,
   "snap": 22.285714285714285
  },
  {
   "id": "es_win",
   "chapter": "WALL",
   "text": "Email to my boss, in English.",
   "lang": "en",
   "start": 22.35,
   "end": 25.55,
   "style": "window",
   "y": 0,
   "snap": 22.285714285714285
  },
  {
   "id": "fr",
   "chapter": "WALL",
   "text": "Parlez fran\u00e7ais.",
   "lang": "fr",
   "start": 25.85,
   "end": 29.95,
   "style": "hero",
   "y": 350,
   "snap": 25.71428571428571
  },
  {
   "id": "fr_sub",
   "chapter": "WALL",
   "text": "supEars \u00e9crit en anglais.",
   "lang": "en",
   "start": 27.25,
   "end": 29.95,
   "style": "sub",
   "y": 620,
   "snap": 27.428571428571427
  },
  {
   "id": "fr_win",
   "chapter": "WALL",
   "text": "Message: I'm running late, see you at nine.",
   "lang": "en",
   "start": 27.45,
   "end": 29.95,
   "style": "window",
   "y": 0,
   "snap": 27.428571428571427
  },
  {
   "id": "quote3",
   "chapter": "WALL",
   "text": "\u201cI searched for voice-to-text without a subscription.\u201d",
   "lang": "en",
   "start": 27.8,
   "end": 29.8,
   "style": "quote",
   "y": 1010,
   "snap": 27.857142857142854
  },
  {
   "id": "de",
   "chapter": "WALL",
   "text": "Sprich Deutsch.",
   "lang": "de",
   "start": 30.15,
   "end": 34.6,
   "style": "hero",
   "y": 350,
   "snap": 30.0
  },
  {
   "id": "de_sub",
   "chapter": "WALL",
   "text": "Keine Cloud, kein Abo.",
   "lang": "en",
   "start": 31.55,
   "end": 34.6,
   "style": "sub",
   "y": 620,
   "snap": 31.71428571428571
  },
  {
   "id": "de_win",
